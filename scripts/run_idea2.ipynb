{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Idea2 End-to-End Runner (Local Gemma-3n)\n",
        "Runs the same pipeline as `src.main.run_idea2_pipeline` with local GPU inference.\n"
      ]
    },
    {
      "cell_type": "python",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from pathlib import Path\n",
        "import os\n",
        "import sys\n",
        "\n",
        "ROOT = Path.cwd().resolve()\n",
        "if str(ROOT) not in sys.path:\n",
        "    sys.path.insert(0, str(ROOT))\n",
        "os.environ.setdefault(\"HF_HUB_DISABLE_PROGRESS_BARS\", \"1\")\n",
        "\n",
        "from src.main import run_idea2_pipeline, TranscriptionFailure\n"
      ]
    },
    {
      "cell_type": "python",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Configure run\n",
        "input_jsonl = None          # e.g., \"data/avut/avut_human_filtered.jsonl\"\n",
        "output_dir = \"outputs\"\n",
        "max_samples = 2\n",
        "run_sample = None           # e.g., \"2\"\n",
        "prefetch_videos = None\n",
        "no_prefetch_videos = False\n",
        "split_max_samples = False\n"
      ]
    },
    {
      "cell_type": "python",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "try:\n",
        "    metrics = run_idea2_pipeline(\n",
        "        input_jsonl=input_jsonl,\n",
        "        output_dir=output_dir,\n",
        "        max_samples=max_samples,\n",
        "        run_sample=run_sample,\n",
        "        prefetch_videos=prefetch_videos,\n",
        "        no_prefetch_videos=no_prefetch_videos,\n",
        "        split_max_samples=split_max_samples,\n",
        "    )\n",
        "except TranscriptionFailure as exc:\n",
        "    raise RuntimeError(f\"FATAL: {exc}\") from exc\n",
        "\n",
        "metrics\n"
      ]
    }
  ],
