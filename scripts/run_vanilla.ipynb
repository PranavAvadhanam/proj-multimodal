      "source": [
        "# Vanilla End-to-End Runner (Local Gemma-3n)\n",
        "Runs the same pipeline as `src.vanilla.pipeline.run_vanilla_pipeline` with local GPU inference.\n"
      ]
    },
    {
      "cell_type": "python",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from pathlib import Path\n",
        "import os\n",
        "import sys\n",
        "\n",
        "ROOT = Path.cwd().resolve()\n",
        "if str(ROOT) not in sys.path:\n",
        "    sys.path.insert(0, str(ROOT))\n",
        "os.environ.setdefault(\"HF_HUB_DISABLE_PROGRESS_BARS\", \"1\")\n",
        "\n",
        "from src.vanilla.pipeline import run_vanilla_pipeline\n"
      ]
    },
    {
      "cell_type": "python",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Configure run\n",
        "input_jsonl = None\n",
        "output_dir = \"outputs\"\n",
        "max_samples = 2\n",
        "run_sample = None\n",
        "prefetch_videos = None\n",
        "no_prefetch_videos = False\n"
      ]
    },
    {
      "cell_type": "python",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "metrics = run_vanilla_pipeline(\n",
        "    input_jsonl=input_jsonl,\n",
        "    output_dir=output_dir,\n",
        "    max_samples=max_samples,\n",
        "    run_sample=run_sample,\n",
        "    prefetch_videos=prefetch_videos,\n",
        "    no_prefetch_videos=no_prefetch_videos,\n",
        ")\n",
        "metrics\n"
      ]
    }
  ],
